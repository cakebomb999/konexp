#: konexp/cli.py:21
msgid ""
"Kommandozeile: python3 -m konexp <befehl> …\n"
"\n"
"  status                      alle Profile: aktive DPI-Stufe, DPI, Polling, Licht, DPI-/Profil-Tasten\n"
"  profile <0-4>               aktives Profil setzen\n"
"  dpi <profil> <stufe> <dpi>  DPI einer Stufe setzen (X und Y)\n"
"  dpi-active <profil> <stufe> aktive DPI-Stufe setzen\n"
"  restore <datei.bin>         gesichertes Backup zurückschreiben\n"
"  dump [datei.json]           alles lesen und als Diagnose-Datei speichern (nur Lesen)\n"
msgstr ""
"Command line: python3 -m konexp <command> …\n"
"\n"
"  status                      all profiles: active DPI stage, DPI, polling, lighting, DPI/profile buttons\n"
"  profile <0-4>               set active profile\n"
"  dpi <profile> <stage> <dpi> set DPI of a stage (X and Y)\n"
"  dpi-active <profile> <stage> set active DPI stage\n"
"  restore <file.bin>          restore saved backup\n"
"  dump [file.json]            read everything and save it as a diagnostic file (read-only)\n"

