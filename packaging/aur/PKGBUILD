# Maintainer: Marco <marco@mpreimann.de
pkgname=konexp
pkgver=0.1.0  # setzt der Release-Workflow aus dem Tag
pkgrel=1
pkgdesc='Linux-Konfiguration für ROCCAT Kone XP / XP Air (DPI, Sensor, Beleuchtung, Tasten)'
arch=('any')
url='https://github.com/cakebomb999/konexp'
license=('GPL-3.0-or-later')
depends=('python' 'pyside6')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 udev/70-kone-xp.rules "$pkgdir/usr/lib/udev/rules.d/70-kone-xp.rules"
}
